<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_line_crypto_traceability_list" model="ir.ui.view">
        <field name="name">account.move.line.crypto.traceability.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Crypto Accounting Lines">
                <field name="date"/>
                <field name="move_id"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="crypto_asset_currency_id"/>
                <field name="crypto_asset_quantity"/>
                <field name="crypto_wallet_address_id"/>
                <field name="crypto_normalized_transaction_id"/>
                <field name="crypto_transaction_hash"/>
                <field name="crypto_source_reference"/>
                <field name="crypto_review_status"/>
            </list>
        </field>
    </record>

    <record id="view_account_move_line_crypto_traceability_form" model="ir.ui.view">
        <field name="name">account.move.line.crypto.traceability.form</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <form string="Crypto Accounting Line">
                <sheet>
                    <group>
                        <group>
                            <field name="move_id" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="debit" readonly="1"/>
                            <field name="credit" readonly="1"/>
                        </group>
                        <group string="Crypto Traceability">
                            <field name="crypto_payment_transaction_id" readonly="1"/>
                            <field name="crypto_account_payment_id" readonly="1"/>
                            <field name="crypto_wallet_address_id" readonly="1"/>
                            <field name="crypto_normalized_transaction_id" readonly="1"/>
                            <field name="crypto_transaction_evm_id" readonly="1"/>
                            <field name="crypto_asset_currency_id" readonly="1"/>
                            <field name="crypto_asset_quantity" readonly="1"/>
                            <field name="crypto_source_reference" readonly="1"/>
                            <field name="crypto_transaction_hash" readonly="1"/>
                            <field name="crypto_review_status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_payment_form_crypto_move_lines" model="ir.ui.view">
        <field name="name">account.payment.form.crypto.move.lines</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-list"
                        type="object"
                        name="action_view_crypto_move_lines"
                        invisible="crypto_move_line_count == 0">
                    <field name="crypto_move_line_count" widget="statinfo" string="Crypto Lines"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_payment_transaction_form_crypto_move_lines" model="ir.ui.view">
        <field name="name">payment.transaction.form.crypto.move.lines</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-list"
                        type="object"
                        name="action_view_crypto_move_lines"
                        invisible="crypto_move_line_count == 0">
                    <field name="crypto_move_line_count" widget="statinfo" string="Crypto Lines"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_crypto_traceability" model="ir.ui.view">
        <field name="name">account.move.form.crypto.traceability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="crypto_payment_transaction_id" readonly="1" invisible="not crypto_payment_transaction_id"/>
                <field name="crypto_account_payment_id" readonly="1" invisible="not crypto_account_payment_id"/>
                <field name="crypto_source_reference" readonly="1" invisible="not crypto_source_reference"/>
                <field name="crypto_transaction_hash" readonly="1" invisible="not crypto_transaction_hash"/>
            </xpath>
        </field>
    </record>
</odoo>
