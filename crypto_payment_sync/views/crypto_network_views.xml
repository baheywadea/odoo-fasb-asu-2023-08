<odoo>
    <record id="view_crypto_network_list" model="ir.ui.view">
        <field name="name">crypto.network.list</field>
        <field name="model">crypto.network</field>
        <field name="arch" type="xml">
            <list string="Crypto Networks">
                <field name="name"/>
                                <field name="technical_name"/>
                <field name="blockchain_id"/>
                <field name="chain_id"/>
                <field name="is_testnet"/>
                <field name="rpc_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_network_form" model="ir.ui.view">
        <field name="name">crypto.network.form</field>
        <field name="model">crypto.network</field>
        <field name="arch" type="xml">
            <form string="Crypto Networks">
                <header>

                    <button string="List HD Wallets" name="sync_wallets" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="technical_name"/>
                        <field name="blockchain_id"/>
                        <field name="chain_id"/>
                        <field name="is_testnet"/>
                        <field name="rpc_url"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crypto_network" model="ir.actions.act_window">
        <field name="name">Crypto Network</field>
        <field name="res_model">crypto.network</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>