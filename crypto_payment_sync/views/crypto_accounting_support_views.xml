<odoo>
    <record id="view_crypto_import_batch_list" model="ir.ui.view">
        <field name="name">crypto.import.batch.list</field>
        <field name="model">crypto.import.batch</field>
        <field name="arch" type="xml">
            <list string="External Import Batches">
                <field name="create_date"/>
                <field name="name"/>
                <field name="source_provider"/>
                <field name="import_format"/>
                <field name="network_id"/>
                <field name="wallet_id"/>
                <field name="raw_count"/>
                <field name="normalized_count"/>
                <field name="exception_count"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_import_batch_form" model="ir.ui.view">
        <field name="name">crypto.import.batch.form</field>
        <field name="model">crypto.import.batch</field>
        <field name="arch" type="xml">
            <form string="External Import Batch">
                <header>
                    <button name="action_import_file" type="object" string="Import Raw Records" class="oe_highlight"
                            invisible="status not in ('draft','exception')"/>
                    <button name="action_normalize_raw_transactions" type="object" string="Normalize Raw Records"
                            invisible="status not in ('imported','needs_review','exception')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_provider"/>
                            <field name="provider_id"/>
                            <field name="import_format"/>
                            <field name="import_file" filename="import_filename"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="network_id"/>
                            <field name="wallet_id"/>
                            <field name="wallet_address_id"/>
                            <field name="raw_count" readonly="1"/>
                            <field name="normalized_count" readonly="1"/>
                            <field name="exception_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Transactions">
                            <field name="raw_transaction_ids" readonly="1"/>
                        </page>
                        <page string="Normalized Transactions">
                            <field name="normalized_transaction_ids" readonly="1"/>
                        </page>
                        <page string="Exceptions">
                            <field name="exception_ids" readonly="1"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_import_batch_search" model="ir.ui.view">
        <field name="name">crypto.import.batch.search</field>
        <field name="model">crypto.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_provider"/>
                <filter name="needs_review" string="Needs Review" domain="[('status','=','needs_review')]"/>
                <filter name="exceptions" string="Exceptions" domain="[('status','=','exception')]"/>
                <separator/>
                <filter name="group_provider" string="Provider" domain="[]" context="{'group_by':'source_provider'}"/>
                <filter name="group_status" string="Status" domain="[]" context="{'group_by':'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_crypto_import_batch" model="ir.actions.act_window">
        <field name="name">External Import Batches</field>
        <field name="res_model">crypto.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crypto_import_batch_search"/>
    </record>

    <record id="action_sync_odoo_crypto_activity" model="ir.actions.server">
        <field name="name">Sync Odoo Crypto Activity</field>
        <field name="model_id" ref="model_crypto_normalized_transaction"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_odoo_crypto_activity()</field>
    </record>

    <record id="view_crypto_raw_transaction_list" model="ir.ui.view">
        <field name="name">crypto.raw.transaction.list</field>
        <field name="model">crypto.raw.transaction</field>
        <field name="arch" type="xml">
            <list string="Raw External Transactions">
                <field name="create_date"/>
                <field name="name"/>
                <field name="import_batch_id"/>
                <field name="source_provider"/>
                <field name="source_row_number"/>
                <field name="transaction_hash"/>
                <field name="source_transaction_id"/>
                <field name="normalized_transaction_id"/>
                <field name="validation_status"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_raw_transaction_form" model="ir.ui.view">
        <field name="name">crypto.raw.transaction.form</field>
        <field name="model">crypto.raw.transaction</field>
        <field name="arch" type="xml">
            <form string="Raw External Transaction">
                <header>
                    <button name="action_normalize" type="object" string="Normalize" class="oe_highlight"/>
                    <field name="validation_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="import_batch_id"/>
                            <field name="source_provider"/>
                            <field name="provider_id"/>
                            <field name="source_row_number"/>
                            <field name="payload_hash" readonly="1"/>
                        </group>
                        <group>
                            <field name="network_id"/>
                            <field name="wallet_id"/>
                            <field name="wallet_address_id"/>
                            <field name="transaction_hash" readonly="1"/>
                            <field name="source_transaction_id" readonly="1"/>
                            <field name="normalized_transaction_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="raw_payload" nolabel="1"/>
                        </page>
                        <page string="Exceptions">
                            <field name="error_message"/>
                            <field name="exception_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_raw_transaction_search" model="ir.ui.view">
        <field name="name">crypto.raw.transaction.search</field>
        <field name="model">crypto.raw.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_hash"/>
                <field name="source_transaction_id"/>
                <field name="payload_hash"/>
                <filter name="exceptions" string="Exceptions" domain="[('validation_status','=','exception')]"/>
                <filter name="normalized" string="Normalized" domain="[('validation_status','=','normalized')]"/>
                <separator/>
                <filter name="group_batch" string="Batch" domain="[]" context="{'group_by':'import_batch_id'}"/>
                <filter name="group_status" string="Status" domain="[]" context="{'group_by':'validation_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_crypto_raw_transaction" model="ir.actions.act_window">
        <field name="name">Raw External Transactions</field>
        <field name="res_model">crypto.raw.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crypto_raw_transaction_search"/>
    </record>

    <record id="view_crypto_ingestion_exception_list" model="ir.ui.view">
        <field name="name">crypto.ingestion.exception.list</field>
        <field name="model">crypto.ingestion.exception</field>
        <field name="arch" type="xml">
            <list string="Ingestion Exceptions">
                <field name="create_date"/>
                <field name="name"/>
                <field name="severity"/>
                <field name="exception_type"/>
                <field name="import_batch_id"/>
                <field name="raw_transaction_id"/>
                <field name="assigned_user_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_ingestion_exception_form" model="ir.ui.view">
        <field name="name">crypto.ingestion.exception.form</field>
        <field name="model">crypto.ingestion.exception</field>
        <field name="arch" type="xml">
            <form string="Ingestion Exception">
                <header>
                    <button name="action_mark_in_review" type="object" string="Mark In Review"/>
                    <button name="action_resolve" type="object" string="Resolve" class="oe_highlight"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="exception_type"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="import_batch_id"/>
                            <field name="raw_transaction_id"/>
                            <field name="normalized_transaction_id"/>
                            <field name="resolved_by" readonly="1"/>
                            <field name="resolved_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="suggested_action"/>
                        <field name="resolution_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_ingestion_exception_search" model="ir.ui.view">
        <field name="name">crypto.ingestion.exception.search</field>
        <field name="model">crypto.ingestion.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="exception_type"/>
                <field name="message"/>
                <filter name="open" string="Open" domain="[('status','=','open')]"/>
                <filter name="in_review" string="In Review" domain="[('status','=','in_review')]"/>
                <filter name="errors" string="Errors" domain="[('severity','=','error')]"/>
                <separator/>
                <filter name="group_status" string="Status" domain="[]" context="{'group_by':'status'}"/>
                <filter name="group_type" string="Type" domain="[]" context="{'group_by':'exception_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_crypto_ingestion_exception" model="ir.actions.act_window">
        <field name="name">Ingestion Exceptions</field>
        <field name="res_model">crypto.ingestion.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crypto_ingestion_exception_search"/>
    </record>

    <record id="view_crypto_normalized_transaction_list" model="ir.ui.view">
        <field name="name">crypto.normalized.transaction.list</field>
        <field name="model">crypto.normalized.transaction</field>
        <field name="arch" type="xml">
            <list string="Normalized Transactions">
                <field name="timestamp"/>
                <field name="import_batch_id"/>
                <field name="source_provider"/>
                <field name="payment_transaction_id"/>
                <field name="network_id"/>
                <field name="asset_symbol"/>
                <field name="quantity"/>
                <field name="transaction_type"/>
                <field name="processing_status"/>
                <field name="transaction_hash"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_normalized_transaction_form" model="ir.ui.view">
        <field name="name">crypto.normalized.transaction.form</field>
        <field name="model">crypto.normalized.transaction</field>
        <field name="arch" type="xml">
            <form string="Normalized Transaction">
                <header>
                    <button name="action_mark_needs_review" type="object" string="Needs Review"/>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed"/>
                    <field name="processing_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="source_provider"/>
                            <field name="import_batch_id"/>
                            <field name="raw_transaction_id"/>
                            <field name="provider_id"/>
                            <field name="payment_transaction_id"/>
                            <field name="account_payment_id"/>
                            <field name="source_transaction_id"/>
                            <field name="transaction_hash"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="blockchain_id"/>
                            <field name="network_id"/>
                            <field name="wallet_id"/>
                            <field name="wallet_address_id"/>
                            <field name="chain_reference"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="asset_symbol"/>
                            <field name="asset_contract_address"/>
                            <field name="quantity"/>
                            <field name="transaction_type"/>
                        </group>
                        <group>
                            <field name="fee_quantity"/>
                            <field name="fee_asset_symbol"/>
                            <field name="counterparty"/>
                            <field name="payload_hash" readonly="1"/>
                            <field name="duplicate_key" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review">
                            <group>
                                <field name="exception_reason"/>
                                <field name="reviewer_notes"/>
                            </group>
                        </page>
                        <page string="Raw Payload">
                            <field name="raw_payload" nolabel="1"/>
                        </page>
                        <page string="Related Support">
                            <group>
                                <field name="account_move_line_ids" readonly="1"/>
                                <field name="fair_value_measurement_ids" readonly="1"/>
                                <field name="journal_preparation_ids" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_normalized_transaction_search" model="ir.ui.view">
        <field name="name">crypto.normalized.transaction.search</field>
        <field name="model">crypto.normalized.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_hash"/>
                <field name="source_transaction_id"/>
                <field name="asset_symbol"/>
                <filter name="needs_review" string="Needs Review" domain="[('processing_status','=','needs_review')]"/>
                <filter name="exceptions" string="Exceptions" domain="[('processing_status','=','exception')]"/>
                <separator/>
                <filter name="group_provider" string="Provider" domain="[]" context="{'group_by':'source_provider'}"/>
                <filter name="group_network" string="Network" domain="[]" context="{'group_by':'network_id'}"/>
                <filter name="group_asset" string="Asset" domain="[]" context="{'group_by':'asset_symbol'}"/>
                <filter name="group_status" string="Status" domain="[]" context="{'group_by':'processing_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_crypto_normalized_transaction" model="ir.actions.act_window">
        <field name="name">Normalized Transactions</field>
        <field name="res_model">crypto.normalized.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crypto_normalized_transaction_search"/>
