                <header>
                    <button name="action_collect_odoo_crypto_activity" type="object" string="Collect Odoo Crypto Activity"
                            class="oe_highlight"/>
                    <button name="action_generate_tax_readiness_outputs" type="object" string="Generate Tax Readiness Lines"/>
                    <button name="action_generate_summary" type="object" string="Generate Summary"/>
                    <button name="action_print_cpa_review_package" type="object" string="Print CPA Review Package"/>
                    <button name="action_print_1099da_readiness" type="object" string="Print 1099-DA Readiness"/>
                    <button name="action_print_form8949_support" type="object" string="Print 8949 Support"/>
                    <button name="action_mark_reviewed" type="object" string="Mark as Reviewed" class="oe_highlight"
                            invisible="status == 'reviewed'"/>
                    <button name="action_return_to_needs_review" type="object" string="Return to Needs Review"
                            invisible="status != 'reviewed'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="payment_transaction_count" readonly="1"/>
                            <field name="crypto_journal_line_count" readonly="1"/>
                            <field name="exception_count" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Odoo Evidence">
                            <field name="payment_transaction_ids" readonly="1"/>
                            <field name="account_payment_ids" readonly="1"/>
                            <field name="account_move_line_ids" readonly="1"/>
                        </page>
                        <page string="Included Records">
                            <field name="normalized_transaction_ids"/>
                            <field name="fair_value_measurement_ids"/>
                            <field name="journal_preparation_ids"/>
                            <field name="reconciliation_status_ids"/>
                            <field name="tax_1099da_ids"/>
                            <field name="form8949_ids"/>
                        </page>
                        <page string="Summary">
                            <field name="summary_markdown" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Reviewer Notes">
                            <field name="reviewer_notes" nolabel="1"/>
                        </page>
                        <page string="Generated Files">
                            <field name="attachment_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

