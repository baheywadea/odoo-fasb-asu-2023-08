<odoo>
    <record id="view_account_payment_form_crypto" model="ir.ui.view">
        <field name="name">account.payment.form.crypto</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//field[@name='journal_id']" position="after">
                <field name="is_crypto" />
                <field name="from_address_id" required="is_crypto" invisible="not is_crypto"/>
                <field name="to_address_id" required="is_crypto" invisible="not is_crypto"/>
                <field name="crypto_transaction_id" readonly="True" invisible="not is_crypto"/>
            </xpath>
        </field>
    </record>

</odoo>