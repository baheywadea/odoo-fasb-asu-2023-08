<odoo>
    <record id="view_currency_form_crypto" model="ir.ui.view">
        <field name="name">res.currency.form.crypto</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/div[1]" position="before">
                <header>
                  <button string="Get Reference" name="get_crypto_referenceid" type="object" invisible="cryptoapis_referenceId"/>
                  <button string="Get Rate" name="get_rate" type="object"/>
                </header>
            </xpath>
            <field name="name" position="after">
                <field name="type"/>
                <field name="cryptoapis_referenceId"/>
            </field>

        </field>
    </record>

    <record id="view_currency_tree_crypto" model="ir.ui.view">
        <field name="name">res.currency.tree.crypto</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="type"/>
                <field name="cryptoapis_referenceId"/>
            </field>

        </field>
    </record>

</odoo>
