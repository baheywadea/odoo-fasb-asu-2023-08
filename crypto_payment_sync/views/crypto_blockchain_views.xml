<odoo>
    <record id="view_crypto_blockchain_list" model="ir.ui.view">
        <field name="name">crypto.blockchain.list</field>
        <field name="model">crypto.blockchain</field>
        <field name="arch" type="xml">
            <list string="Crypto Blockchains">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="symbol"/>
                <field name="network_type"/>
                <field name="explorer_url"/>
                <field name="active"/>

            </list>
        </field>
    </record>

    <record id="view_crypto_blockchain_form" model="ir.ui.view">
        <field name="name">crypto.blockchain.form</field>
        <field name="model">crypto.blockchain</field>
        <field name="arch" type="xml">
            <form string="Crypto Blockchains">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="technical_name"/>
                        <field name="symbol"/>
                        <field name="network_type"/>
                        <field name="explorer_url"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crypto_blockchain" model="ir.actions.act_window">
        <field name="name">Crypto Blockchains</field>
        <field name="res_model">crypto.blockchain</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>