<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="account_payment_method_crypto" model="account.payment.method">
        <field name="name">Crypto Payment</field>
        <field name="code">crypto</field>
        <field name="payment_type">inbound</field>
    </record>

    <record id="payment_provider_crypto" model="payment.provider">
        <field name="name">Crypto Payment</field>
        <field name="code">crypto</field>
        <field name="image_128" type="base64" file="crypto_payment_sync/static/description/icon.png"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('crypto_payment_sync.payment_method_crypto')])]"
        />
        <field name="allow_express_checkout">True</field>
        <field name="allow_tokenization">True</field>
        <field name="support_refund">partial</field>
        <field name="module_id" ref="base.module_crypto_payment_sync"/>
        <field name="redirect_form_view_id" ref="crypto_payment_sync.redirect_form"/>
    </record>

</odoo>
