<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="crypto_payment_sync.group_crypto_user_privilege" model="res.groups.privilege">
            <field name="name">Crypto Privilege</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="crypto_payment_sync.group_crypto_user" model="res.groups">
            <field name="name">Crypto Accounting User</field>
            <field name="privilege_id" ref="crypto_payment_sync.group_crypto_user_privilege"/>
        </record>

        <record id="crypto_payment_sync.group_crypto_reviewer" model="res.groups">
            <field name="name">Crypto Accounting Reviewer</field>
            <field name="privilege_id" ref="crypto_payment_sync.group_crypto_user_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_user'))]"/>
        </record>

        <record id="crypto_payment_sync.group_crypto_admin" model="res.groups">
            <field name="name">Crypto Accounting Manager</field>
            <field name="privilege_id" ref="crypto_payment_sync.group_crypto_user_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_reviewer'))]"/>

        </record>
    </data>
</odoo>
